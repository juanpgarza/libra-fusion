<?xml version="1.0"?>
<odoo>

    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <field name="categ_id" position="after">
                <field name="excluir_calculo_markup" />
            </field>

        </field>
    </record>

    <record id="view_stock_product_template_tree" model="ir.ui.view">
        <field name="name">product.template.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_stock_product_template_tree"></field>
        <field name="arch" type="xml">
            <field name="virtual_available" position="after">
                <field name="meses_de_stock" groups="base.group_user" optional="show"/>
            </field>
        </field>
    </record>

</odoo>