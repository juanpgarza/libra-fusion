<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_no_exigir_campos_producto_vendible" model="res.groups">
        <field name="name">NO exigir campos obligatorios para hacer producto vendible</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
    </record>

    <record id="group_commitment_date_required" model="res.groups">
        <field name="name">Fecha de compromiso obligatoria</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
    </record>

    <record id="group_stock_omitir_bloqueo_pendiente_facturar" model="res.groups">
        <field name="name">Omitir bloqueo de entrega por productos sin facturar</field>
        <field name="category_id" ref="base.module_category_warehouse_management"/>
    </record>

    <!-- el modulo de adhoc tiene otro permiso, pero te oculta el boton
      stock_ux.allow_picking_cancellation -->
    <record id="group_cancel_picking" model="res.groups">
        <field name="name">Permiso para cancelar movimiento de stock (entrega)</field>
        <field name="category_id" ref="base.module_category_warehouse_management"/>
    </record>

    <record id="group_ventas_solo_lectura_pedidos" model="res.groups">
        <field name="name">Ventas - Pedidos solo lectura (con chatter)</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
    </record>

    <record id="group_unlock_sale_order" model="res.groups">
        <field name="name">Desbloquear/Bloquear pedido de ventas</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
    </record>

    <record id="group_edit_delete_message" model="res.groups">
        <field name="name">Permiso para editar o eliminar notas del chatter</field>
        <field name="category_id" ref="base.module_category_sales_management"/>
    </record>

    <record id="group_compras_solo_lectura_ordenes_compra" model="res.groups">
        <field name="name">Compras - Ordenes de compras solo lectura (con chatter)</field>
        <field name="category_id" ref="base.module_category_purchase_management"/>
    </record>

    <record id="group_payment_to_draft" model="res.groups">
        <field name="name">Establecer recibo como borrador</field>
        <field name="category_id" ref="base.module_category_accounting_and_finance"/>
    </record>

    <record id="group_cancelar_comprobante_fiscal" model="res.groups">
        <field name="name">Permiso para pasar a borrador/cancelar comprobante fiscal</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
    </record>

</odoo>